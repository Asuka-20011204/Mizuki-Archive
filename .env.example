MYSQL_DATABASE=archive
MYSQL_USER=archive
MYSQL_HOST_PORT=3307
MYSQL_PASSWORD=replace-with-a-unique-local-password
MYSQL_ROOT_PASSWORD=replace-with-another-unique-local-password

APP_ORIGIN=http://localhost:5173
APP_LISTEN_ADDR=127.0.0.1:8080
APP_DATA_DIR=./data/files
APP_ADMIN_USERNAME=owner
APP_ADMIN_PASSWORD_HASH='replace-with-bcrypt-hash'

# 仅独立 Docker 部署使用：迁移容器使用独立账号，API/Worker 使用 MYSQL_USER。
# MYSQL_MIGRATION_USER=archive_migrator
# MYSQL_MIGRATION_PASSWORD=replace-with-a-safe-random-migration-password
# APP_AUTO_MIGRATE=true
# APP_TRUST_PROXY_HEADERS=false
MYSQL_DSN=archive:replace-with-local-password@tcp(127.0.0.1:3307)/archive

# 可选：完整填写后启用邮箱注册/登录；不要把真实 SMTP 凭据提交到 Git。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-with-smtp-username
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM=archive@example.com
# SMTP_CA_FILE=replace-with-optional-CA-certificate-path
# EMAIL_CODE_SECRET=replace-with-at-least-32-random-bytes

# 可选生产覆盖：将秘密放在仓库外的只读文件，并与 compose.secrets.yaml 一起使用。
# MYSQL_DSN_SECRET_FILE=C:/secure/mizuki/mysql-dsn
# MIGRATION_DSN_SECRET_FILE=C:/secure/mizuki/migration-dsn
# ADMIN_PASSWORD_HASH_SECRET_FILE=C:/secure/mizuki/admin-password-hash
# SMTP_PASSWORD_SECRET_FILE=C:/secure/mizuki/smtp-password
# EMAIL_CODE_SECRET_SECRET_FILE=C:/secure/mizuki/email-code-secret
# 可选 TLS 覆盖：证书和私钥必须位于仓库外，使用 compose.tls.yaml。
# TLS_CERT_FILE=C:/secure/mizuki/fullchain.pem
# TLS_KEY_FILE=C:/secure/mizuki/privkey.pem
# DEPLOY_TLS_PORT=18443

PROCESSING_DELIVERY_MODE=database
PROCESSING_WORKERS=2
PROCESSING_MAX_OUTSTANDING=100
RABBITMQ_USER=archive_worker
RABBITMQ_PASSWORD=replace-with-a-unique-rabbitmq-password
RABBITMQ_URL=amqp://archive_worker:replace-with-a-unique-rabbitmq-password@127.0.0.1:5672/
RABBITMQ_EXCHANGE=mizuki.archive.processing.v1
RABBITMQ_QUEUE=mizuki.archive.processing.v1
RABBITMQ_DEAD_QUEUE=mizuki.archive.processing.v1.dead
RABBITMQ_PREFETCH=2

REDIS_PASSWORD=replace-with-a-unique-redis-password
REDIS_HOST_PORT=6381
REDIS_URL=redis://:replace-with-a-unique-redis-password@127.0.0.1:6381/0
REDIS_KEY_PREFIX=mizuki:v4:
